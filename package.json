    "check": "node --check server.mjs",
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google",
    "gmail",
    "google-calendar",
    "google-drive",
    "google-contacts",
    "opencode",
    "claude"
  ],
