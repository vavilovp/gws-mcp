{
  "name": "gws-mcp",
  "version": "0.4.0",
  "description": "Minimal Google Workspace MCP server for Gmail, Calendar, Drive and Contacts. Zero dependencies.",
  "type": "module",
  "bin": {
    "gws-mcp": "./server.mjs"
  },
  "files": [
    "server.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
